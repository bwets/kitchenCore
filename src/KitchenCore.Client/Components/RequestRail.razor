@inject MenuClient Menu
@inject AuthService Auth
@inject IStringLocalizer<Strings> L

@*
    Requests for no particular day.

    They have no date, so they cannot live in the grid; they sit beside it and are
    dragged onto a day when someone decides when to cook them. Each is a drag
    handle with no date of its own, which the drop handler recognises.
*@

@if (Requests.Count > 0 || CanRequest)
{
    <aside class="rail">
        <header class="rail__head">
            <h2 class="rail__title">@L["Requests_Title"]</h2>
            @if (Requests.Count > 0)
            {
                <span class="rail__count">@Requests.Count</span>
            }
        </header>

        @if (Requests.Count == 0)
        {
            <p class="rail__empty">@L["Requests_Empty"]</p>
        }
        else
        {
            <ul class="rail__list">
                @foreach (var request in Requests)
                {
                    <li>
                        <div class="rail__item"
                             data-drag-request="@request.Ordinal"
                             data-drag-title="@request.Title"
                             title="@request.Notes">
                            <span class="rail__item-title">@request.Title</span>
                            @if (!string.IsNullOrWhiteSpace(request.By))
                            {
                                <span class="rail__item-by">@request.By</span>
                            }
                        </div>
                    </li>
                }
            </ul>
        }

        @if (CanRequest)
        {
            <div class="rail__add">
                <input class="field__input" placeholder="@L["Requests_Placeholder"]"
                       value="@_title"
                       @oninput="e => _title = e.Value?.ToString() ?? string.Empty"
                       @onkeydown="OnKeyDown" />
                <button type="button" class="button button--primary"
                        disabled="@string.IsNullOrWhiteSpace(_title)"
                        @onclick="AddAsync">
                    @L["Requests_Add"]
                </button>
            </div>
        }
    </aside>
}

@code {
    private string _title = string.Empty;

    [Parameter]
    public IReadOnlyList<MenuRequest> Requests { get; set; } = [];

    [Parameter]
    public EventCallback OnChanged { get; set; }

    private bool CanRequest => Auth.Identity.CanRequest(Section.Menu);

    private async Task OnKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            await AddAsync();
        }
    }

    private async Task AddAsync()
    {
        if (string.IsNullOrWhiteSpace(_title))
        {
            return;
        }

        if (await Menu.AddRequestAsync(_title.Trim(), null))
        {
            _title = string.Empty;
            await OnChanged.InvokeAsync();
        }
    }
}
