@implements IDisposable
@inject SystemStatusService Status
@inject IStringLocalizer<Strings> L

@* Which repository the data folder is, or a plain statement that there is none.
   Git is enabled by the data folder being a repo, never by a setting, so this
   badge is the one place that answers "why is nothing syncing?". *@

@if (_git is null)
{
    <span class="git-badge">
        <svg class="git-badge__icon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M7 18a4.5 4.5 0 0 1-.6-9 6 6 0 0 1 11.5 1.6A3.8 3.8 0 0 1 17.5 18z" /></svg>
        <span class="git-badge__text">@L["Loading"]</span>
    </span>
}
else if (_git.Enabled)
{
    <span class="git-badge git-badge--on" title="@(_git.RemoteUrl ?? ReasonText(_git.Reason))">
        <svg class="git-badge__icon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M7 18a4.5 4.5 0 0 1-.6-9 6 6 0 0 1 11.5 1.6A3.8 3.8 0 0 1 17.5 18z" /></svg>
        <span class="git-badge__text">@_git.Repository</span>
        @if (!string.IsNullOrEmpty(_git.Branch))
        {
            <span class="git-badge__text git-badge__branch">· @_git.Branch</span>
        }
    </span>
}
else
{
    <span class="git-badge" title="@ReasonText(_git.Reason)">
        <svg class="git-badge__icon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M7 18a4.5 4.5 0 0 1-.6-9 6 6 0 0 1 11.5 1.6A3.8 3.8 0 0 1 17.5 18z" /></svg>
        <span class="git-badge__text">@L["Git_LocalOnly"]</span>
    </span>
}

@code {
    private GitStatus? _git;
    private SyncSummary? _sync;

    protected override async Task OnInitializedAsync()
    {
        Status.Changed += OnChanged;
        var status = await Status.GetAsync();
        _git = status.Git;
        _sync = status.Sync;
    }

    private void OnChanged()
    {
        _git = Status.Current?.Git;
        _sync = Status.Current?.Sync;
        StateHasChanged();
    }

    public void Dispose() => Status.Changed -= OnChanged;

    private string ReasonText(GitDisabledReason reason) => reason switch
    {
        GitDisabledReason.NotARepository => L["Git_Reason_NotARepository"],
        GitDisabledReason.DataFolderMissing => L["Git_Reason_DataFolderMissing"],
        GitDisabledReason.NoRemote => L["Git_Reason_NoRemote"],
        _ => string.Empty,
    };
}
