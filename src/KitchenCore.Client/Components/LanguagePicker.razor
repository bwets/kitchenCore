@using System.Globalization
@inject SystemStatusService Status
@inject CulturePreference Culture
@inject IStringLocalizer<Strings> L

@* A menu, like the theme picker's and sharing its styles: the header has room
   for one button here, not one per language. Closed, it shows the current
   language's code; open, every language by its own name. *@

<div class="theme-picker lang-picker">
    <button type="button"
            class="theme-picker__trigger lang-picker__trigger"
            aria-haspopup="menu"
            aria-expanded="@_open"
            title="@L["Status_Language"]"
            @onclick="() => _open = !_open">
        <span aria-hidden="true">@_current.ToUpperInvariant()</span>
        <span class="visually-hidden">@L["Status_Language"]: @DisplayName(_current)</span>
    </button>

    @if (_open)
    {
        @* Catches clicks anywhere else so the menu closes without a JS listener. *@
        <button type="button" class="theme-picker__scrim" tabindex="-1"
                aria-hidden="true" @onclick="() => _open = false"></button>

        <ul class="theme-picker__menu" role="menu">
            @foreach (var culture in _available)
            {
                var isCurrent = string.Equals(culture, _current, StringComparison.OrdinalIgnoreCase);

                <li role="none">
                    <button type="button" role="menuitemradio" aria-checked="@isCurrent"
                            class="theme-picker__item @(isCurrent ? "is-current" : null)"
                            lang="@culture"
                            @onclick="() => SelectAsync(culture)">
                        <span class="lang-picker__code">@culture.ToUpperInvariant()</span>
                        <span>@DisplayName(culture)</span>
                    </button>
                </li>
            }
        </ul>
    }
</div>

@code {
    private string _current = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    private List<string> _available = ["fr", "en"];
    private bool _open;

    protected override async Task OnInitializedAsync()
    {
        var status = await Status.GetAsync();
        if (status.AvailableCultures.Count > 0)
        {
            _available = [.. status.AvailableCultures];
        }
    }

    private async Task SelectAsync(string culture)
    {
        _open = false;

        if (!string.Equals(culture, _current, StringComparison.OrdinalIgnoreCase))
        {
            // Changing culture means restarting the WebAssembly runtime, so this reloads.
            await Culture.SetAsync(culture);
        }
    }

    /// <summary>Each language in its own words: someone looking for theirs reads it that way.</summary>
    private static string DisplayName(string culture) => culture switch
    {
        "fr" => "Français",
        "en" => "English",
        _ => culture,
    };
}
