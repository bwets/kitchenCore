@implements IDisposable
@inject ThemePreference Theme
@inject IStringLocalizer<Strings> L

@* A menu rather than a segmented toggle: the theme list is open-ended (Nord and
   Darcula are already here, more will follow), so it has to grow without
   redesigning the header. Custom because Fluent v5's menu API is still moving. *@

<div class="theme-picker">
    <button type="button"
            class="theme-picker__trigger"
            aria-haspopup="menu"
            aria-expanded="@_open"
            title="@L["Theme_Label"]"
            @onclick="Toggle">
        @* A palette, not a bare colour dot: a circle alone said nothing about
           what tapping it would do. *@
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor"
             stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 3a9 9 0 1 0 0 18c1.1 0 1.7-.8 1.7-1.7 0-.5-.2-.9-.5-1.2-.3-.3-.5-.7-.5-1.2 0-1 .8-1.7 1.7-1.7H16a5 5 0 0 0 5-5C21 6.6 17 3 12 3z" />
            <circle cx="7.5" cy="11" r="1" fill="currentColor" />
            <circle cx="10.5" cy="7.5" r="1" fill="currentColor" />
            <circle cx="15" cy="7.5" r="1" fill="currentColor" />
        </svg>
        <span class="visually-hidden">@L["Theme_Label"]: @L[Theme.Current.LabelKey]</span>
    </button>

    @if (_open)
    {
        @* Catches clicks anywhere else so the menu closes without a JS listener. *@
        <button type="button" class="theme-picker__scrim" tabindex="-1"
                aria-hidden="true" @onclick="Close"></button>

        <ul class="theme-picker__menu" role="menu">
            @foreach (var option in ThemeCatalog.All)
            {
                var isCurrent = option.Id == Theme.Current.Id;

                <li role="none">
                    <button type="button" role="menuitemradio" aria-checked="@isCurrent"
                            class="theme-picker__item @(isCurrent ? "is-current" : null)"
                            @onclick="() => SelectAsync(option)">
                        <span class="theme-picker__swatch" style="background:@option.Swatch"></span>
                        <span>@L[option.LabelKey]</span>
                    </button>
                </li>
            }
        </ul>
    }
</div>

@code {
    private bool _open;

    protected override async Task OnInitializedAsync()
    {
        Theme.Changed += OnChanged;
        await Theme.InitializeAsync();
    }

    private void Toggle() => _open = !_open;

    private void Close() => _open = false;

    private async Task SelectAsync(ThemeOption option)
    {
        _open = false;
        await Theme.SetAsync(option);
    }

    private void OnChanged() => StateHasChanged();

    public void Dispose() => Theme.Changed -= OnChanged;
}
