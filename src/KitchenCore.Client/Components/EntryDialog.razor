@implements IAsyncDisposable
@inject MenuClient Menu
@inject AuthService Auth
@inject SystemStatusService Status
@inject UiInterop Ui
@inject IStringLocalizer<Strings> L

@*
    Create, edit or delete one entry.

    Reached from any cell in any view, which is what "I should be able to create
    entries from any view" comes down to. A custom dialog rather than Fluent's:
    it needs a datalist-backed title field and a delete affordance that is
    present but not adjacent to save.
*@

@if (Target is not null)
{
    <div class="dialog-scrim" @onclick="Cancel"></div>

    @* Wide, with the notes in a column of their own, when there are notes to
       read: a recipe beside its title rather than under it. The notes are the
       only part that scrolls, so the title and the buttons stay in view. *@
    <div class="dialog dialog--entry @(_split ? "dialog--split" : null) @SlotTone.CssClass(Target.Slot)"
         role="dialog" aria-modal="true" aria-label="@Heading()">
        @* Reading, the dish is the heading; editing, the heading says what is
           being done and the title is a field like the rest. *@
        <header class="dialog__head entry-head">
            <div class="entry-head__text">
                <p class="slot-tag entry-head__when">
                    <span class="slot-tag__swatch" aria-hidden="true"></span>
                    @SubHeading()
                </p>
                <h2 class="dialog__title entry-head__title">@(CanEdit ? Heading() : _title)</h2>
            </div>
            <button type="button" class="entry-head__close" aria-label="@L["Close"]" title="@L["Close"]" @onclick="Cancel">×</button>
        </header>

        @* Reading a recipe with no links, the notes take the whole width. *@
        <div class="entry-body @(!CanEdit && Target.Entry.Links.Count == 0 ? "entry-body--notes-only" : null)">
            <div class="entry-body__main">
                @if (CanEdit)
                {
                    <label class="field">
                        <span class="field__label">@L["Entry_Title"]</span>
                        <input class="field__input"
                               list="known-titles"
                               @ref="_titleField"
                               value="@_title"
                               @oninput="e => _title = e.Value?.ToString() ?? string.Empty"
                               @onkeydown="OnKeyDown" />
                    </label>
                }

                @* Every title already used, so repeating a favourite is a couple of
                   keystrokes rather than retyping it. *@
                <datalist id="known-titles">
                    @foreach (var title in _knownTitles)
                    {
                        <option value="@title"></option>
                    }
                </datalist>

                @if (!CanEdit)
                {
                    @if (Target?.Entry.Links.Count > 0)
                    {
                        @* A card per link, named by its site: a long URL is noise. *@
                        <ul class="link-cards" aria-label="@L["Entry_Links"]">
                            @foreach (var link in Target.Entry.Links)
                            {
                                <li>
                                    <a class="link-card" href="@link" target="_blank" rel="noopener noreferrer" title="@link">
                                        <span class="link-card__icon" aria-hidden="true">
                                            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1" /></svg>
                                        </span>
                                        <span class="link-card__text">
                                            <span class="link-card__site">@Site(link)</span>
                                            <span class="link-card__url">@link</span>
                                        </span>
                                    </a>
                                </li>
                            }
                        </ul>
                    }
                }
                else
                {
                    <label class="field">
                        <span class="field__label">@L["Entry_Links"]</span>
                        <textarea class="field__input field__input--area"
                                  rows="2"
                                  placeholder="https://..."
                                  value="@_links"
                                  @oninput="e => _links = e.Value?.ToString() ?? string.Empty"></textarea>
                        <span class="field__hint">@L["Entry_LinksHint"]</span>
                    </label>
                }
            </div>

            @if (!CanEdit)
            {
                @if (_split)
                {
                    <section class="field entry-body__notes" aria-label="@L["Entry_Notes"]">
                        <div class="entry-body__scroll entry-body__read"><MarkdownText Text="@_notes" /></div>
                    </section>
                }
            }
            else
            {
                <label class="field entry-body__notes">
                    <span class="field__label">@L["Entry_Notes"]</span>
                    <textarea class="field__input field__input--area entry-body__scroll"
                              rows="12"
                              value="@_notes"
                              @oninput="e => _notes = e.Value?.ToString() ?? string.Empty"></textarea>
                    <span class="field__hint">@L["Entry_NotesHint"]</span>
                </label>
            }
        </div>

        @if (_error is { Length: > 0 })
        {
            <p class="dialog__error">@_error</p>
        }

        <footer class="dialog__foot">
            @if (IsExisting && CanEdit)
            {
                <button type="button" class="button button--danger" @onclick="DeleteAsync" disabled="@_busy">
                    @L["Entry_Delete"]
                </button>
            }

            <span class="dialog__spacer"></span>

            <button type="button" class="button" @onclick="Cancel" disabled="@_busy">
                @(CanEdit ? L["Cancel"] : L["Close"])
            </button>

            @if (CanEdit)
            {
                <button type="button" class="button button--primary" @onclick="SaveAsync"
                        disabled="@(_busy || string.IsNullOrWhiteSpace(_title))">
                    @L["Save"]
                </button>
            }
        </footer>
    </div>
}

@code {
    private string _title = string.Empty;
    private string _notes = string.Empty;
    private string _links = string.Empty;
    private bool _split;
    private string? _error;
    private bool _busy;
    private IReadOnlyList<string> _knownTitles = [];
    private MenuEntryRef? _lastTarget;
    private ElementReference _titleField;
    private bool _focusPending;
    private DotNetObjectReference<EntryDialog>? _self;

    /// <summary>The cell being edited. Null closes the dialog.</summary>
    [Parameter]
    public MenuEntryRef? Target { get; set; }

    /// <summary>Version the grid last loaded, sent as If-Match.</summary>
    [Parameter]
    public string? Version { get; set; }

    [Parameter]
    public EventCallback OnSaved { get; set; }

    [Parameter]
    public EventCallback OnCancelled { get; set; }

    /// <summary>True when editing something that already exists, rather than creating.</summary>
    private bool IsExisting => Target is { Entry.Title.Length: > 0 };

    /// <summary>
    /// The view is in reading mode, so even an editor gets the entry shown
    /// rather than an editor for it. Switching to edit mode is one tap away.
    /// </summary>
    [Parameter]
    public bool ReadOnly { get; set; }

    private bool CanEdit => !ReadOnly && Auth.Identity.CanEdit(Section.Menu);

    protected override async Task OnParametersSetAsync()
    {
        // Reset only when the dialog opens on a different cell, or typing would be
        // discarded on every re-render of the parent.
        if (!ReferenceEquals(Target, _lastTarget))
        {
            _lastTarget = Target;
            _error = null;

            // Focus after the render that actually shows the field.
            _focusPending = Target is not null && CanEdit;

            _title = Target?.Entry.Title ?? string.Empty;
            _notes = Target?.Entry.Notes ?? string.Empty;

            // Creating and editing always have the notes column, since that is
            // where they get written; reading has it when there is something to
            // read. Decided on opening, so the layout never jumps while typing.
            _split = CanEdit || !string.IsNullOrWhiteSpace(_notes);
            _links = Target is null ? string.Empty : string.Join('\n', Target.Entry.Links);
        }

        if (Target is not null && _knownTitles.Count == 0)
        {
            _knownTitles = await Menu.TitlesAsync();
        }

        if (Target is not null)
        {
            _self ??= DotNetObjectReference.Create(this);
            await Ui.RegisterEscapeAsync(_self);
        }
        else if (_self is not null)
        {
            await Ui.UnregisterEscapeAsync(_self);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusPending)
        {
            _focusPending = false;

            // Selecting the existing title means editing is "type the new name",
            // not "clear the old one first".
            await Ui.FocusAndSelectAsync(_titleField);
        }
    }

    [JSInvokable]
    public async Task HandleEscape() => await Cancel();

    public async ValueTask DisposeAsync()
    {
        if (_self is not null)
        {
            await Ui.UnregisterEscapeAsync(_self);
            _self.Dispose();
        }
    }

    private async Task OnKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter" && !string.IsNullOrWhiteSpace(_title))
        {
            await SaveAsync();
        }
        else if (args.Key == "Escape")
        {
            await Cancel();
        }
    }

    private async Task SaveAsync()
    {
        if (Target is null || string.IsNullOrWhiteSpace(_title))
        {
            return;
        }

        _busy = true;
        _error = null;

        var entry = new MenuEntry
        {
            Title = _title.Trim(),
            Notes = string.IsNullOrWhiteSpace(_notes) ? null : _notes.Trim(),
            Links = [.. _links
                .Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)],
            Status = Target.Entry.Status,
            RequestedBy = Target.Entry.RequestedBy,
        };

        var result = await Menu.UpsertAsync(Target.Date, Target.Slot, entry, Target.Index, Version);
        _busy = false;

        if (result.Conflict)
        {
            _error = L["Conflict"];
            return;
        }

        if (!result.Success)
        {
            _error = L[result.ResourceKey ?? "SaveFailed"];
            return;
        }

        await OnSaved.InvokeAsync();
    }

    private async Task DeleteAsync()
    {
        if (Target is null)
        {
            return;
        }

        _busy = true;
        _error = null;

        var result = await Menu.DeleteAsync(Target.Date, Target.Slot, Target.Index, Version);
        _busy = false;

        if (result.Conflict)
        {
            _error = L["Conflict"];
            return;
        }

        if (!result.Success)
        {
            _error = L[result.ResourceKey ?? "SaveFailed"];
            return;
        }

        await OnSaved.InvokeAsync();
    }

    private Task Cancel() => OnCancelled.InvokeAsync();

    private string Heading() => IsExisting ? L["Entry_Edit"] : L["Entry_New"];

    /// <summary>"youtube.com" for https://www.youtube.com/watch?v=…; the link itself when it does not parse.</summary>
    private static string Site(string link) =>
        Uri.TryCreate(link, UriKind.Absolute, out var uri) && uri.Host.Length > 0
            ? (uri.Host.StartsWith("www.", StringComparison.OrdinalIgnoreCase) ? uri.Host[4..] : uri.Host)
            : link;

    private string SubHeading() => Target is null
        ? string.Empty
        : $"{Target.Date.ToString("dddd d MMMM")} · {SlotLabel(Target.Slot)}";

    /// <summary>The slot as the family named it in config, not its key. Status is loaded long before any dialog opens.</summary>
    private string SlotLabel(string key) =>
        Status.Current?.Slots.FirstOrDefault(s => string.Equals(s.Key, key, StringComparison.OrdinalIgnoreCase))
            ?.Label(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName)
        ?? key;
}
