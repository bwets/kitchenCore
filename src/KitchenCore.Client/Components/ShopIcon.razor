@*
    A shopping list's mark: its icon in a circle of the shop's colour. The
    colour fills the circle rather than tinting the glyph, so it reads the same
    on a light theme as on a dark one; the glyph is black or white, whichever
    holds on that colour. A list without a colour takes the theme's neutral.
*@

<span class="shop-icon @Class" style="@Style()" aria-hidden="true">
    <svg viewBox="0 0 24 24" width="@Size" height="@Size" fill="none" stroke="currentColor"
         stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
        <path d="@Path()" />
    </svg>
</span>

@code {
    [Parameter, EditorRequired]
    public ShoppingListDefinition List { get; set; } = default!;

    [Parameter]
    public string? Class { get; set; }

    /// <summary>The glyph's size in px; the circle is sized in CSS around it.</summary>
    [Parameter]
    public int Size { get; set; } = 14;

    private string Path() => List.Icon switch
    {
        "cart" => "M3 4h2.2l2.3 10.4h10.3L20 7H6.4M9.5 19.2h.01M16.5 19.2h.01",
        "basket" => "M4 10h16l-1.6 9H5.6zM8.5 10 11 4.5M15.5 10 13 4.5M9.5 14v2.5M14.5 14v2.5",
        "store" => "M4 9.5 5.5 4h13L20 9.5M4 9.5h16M4 9.5V20h16V9.5M10 20v-5h4v5",
        _ => "M6 8h12l-1 12H7zM9.5 8V6.5a2.5 2.5 0 0 1 5 0V8",
    };

    // The server passes on only #rrggbb, so this never writes anything else
    // into the attribute.
    private string? Style() =>
        List.Color is { } color && ShoppingListDefinition.IsValidColor(color)
            ? $"background:{color};color:{InkOn(color)}"
            : null;

    /// <summary>Black or white, by the colour's relative luminance.</summary>
    private static string InkOn(string hex)
    {
        static double Channel(string hex, int at)
        {
            var c = Convert.ToInt32(hex.Substring(at, 2), 16) / 255.0;
            return c <= 0.03928 ? c / 12.92 : Math.Pow((c + 0.055) / 1.055, 2.4);
        }

        var luminance = (0.2126 * Channel(hex, 1)) + (0.7152 * Channel(hex, 3)) + (0.0722 * Channel(hex, 5));

        // The crossover where black and white give the same contrast.
        return luminance > 0.179 ? "#141613" : "#ffffff";
    }
}
