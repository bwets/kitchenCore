@inject IStringLocalizer<Strings> L

@*
    The right end of every menu view's bar: requests, refresh, and the switch
    between reading and editing. One component so the three views cannot each
    grow their own slightly different version of it.
*@

@if (CanEdit && Editing)
{
    @* Placing requests is editing, so the sidebar lives behind edit mode. *@
    <button type="button" class="week-bar__button @(PanelOpen ? "is-on" : null)" @onclick="OnRequests">
        @L["Requests_Title"]
        @if (RequestCount > 0)
        {
            <span class="week-bar__count">@RequestCount</span>
        }
    </button>
}
else if (CanRequest)
{
    <button type="button" class="week-bar__button" @onclick="OnRequests">
        @L["Requests_Ask"]
        @if (RequestCount > 0)
        {
            <span class="week-bar__count">@RequestCount</span>
        }
    </button>
}

<button type="button" class="week-bar__button week-bar__icon @(Loading ? "is-spinning" : null)"
        title="@L["Refresh"]" aria-label="@L["Refresh"]"
        disabled="@Loading"
        @onclick="OnRefresh">
    <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none"
         stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M20 11a8 8 0 1 0-2.3 5.7" />
        <path d="M20 4v7h-7" />
    </svg>
</button>

@if (CanEdit)
{
    <button type="button" class="week-bar__button week-bar__mode @(Editing ? "is-on" : null)"
            aria-pressed="@(Editing ? "true" : "false")"
            title="@(Editing ? L["Mode_EditingHint"] : L["Mode_ViewingHint"])"
            @onclick="OnToggleEdit">
        <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true" fill="none"
             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 20h9" />
            <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z" />
        </svg>
        @(Editing ? L["Mode_Done"] : L["Mode_Edit"])
    </button>
}

@code {
    [Parameter] public bool Loading { get; set; }
    [Parameter] public EventCallback OnRefresh { get; set; }

    [Parameter] public bool CanEdit { get; set; }
    [Parameter] public bool CanRequest { get; set; }

    /// <summary>Edit mode is on.</summary>
    [Parameter] public bool Editing { get; set; }

    [Parameter] public EventCallback OnToggleEdit { get; set; }

    [Parameter] public int RequestCount { get; set; }
    [Parameter] public bool PanelOpen { get; set; }
    [Parameter] public EventCallback OnRequests { get; set; }
}
