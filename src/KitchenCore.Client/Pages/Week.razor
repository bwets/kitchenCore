@page "/menu/week"
@inherits MenuViewBase
@inject UiInterop Ui

<PageTitle>@L["Week_Title"] · @L["AppName"]</PageTitle>

<div class="week-bar">
    <button type="button" class="week-bar__button" @onclick="() => ShiftAsync(-7)" title="@L["Week_Previous"]">‹</button>
    <button type="button" class="week-bar__button" @onclick="GoToTodayAsync">@L["Week_Today"]</button>
    <button type="button" class="week-bar__button" @onclick="() => ShiftAsync(7)" title="@L["Week_Next"]">›</button>

    <span class="week-bar__range">@RangeLabel()</span>
    <span class="week-bar__spacer"></span>

    @* Snack and special are hidden while the week has none: two of four rows
       standing empty is a poor use of the screen. The toggle brings them back,
       and a week that already uses them shows them regardless. *@
    @if (ShowAllSlots || SlotVisibility.HasHidden(AllSlots, Range?.Days ?? [], ShowAllSlots))
    {
        <button type="button" class="week-bar__button @(ShowAllSlots ? "is-on" : null)"
                @onclick="() => ShowAllSlots = !ShowAllSlots">
            @(ShowAllSlots ? L["Slots_Fewer"] : L["Slots_All"])
        </button>
    }

    @* Requests live here rather than beside the calendar: a panel open all the
       time costs the grid width it needs more. *@
    <MenuTools Loading="Loading"
               OnRefresh="RefreshAsync"
               CanEdit="CanEdit"
               CanRequest="CanRequest"
               Editing="Editable"
               OnToggleEdit="ToggleEditMode"
               RequestCount="RequestCount"
               PanelOpen="@(Panel == RequestPanelMode.Place)"
               OnRequests="OpenRequests" />
</div>

@if (LoadError is { Length: > 0 })
{
    <div class="issues">@LoadError</div>
}

@if (Conflict)
{
    <div class="issues">@L["Conflict"]</div>
}

@if (Range is { Issues.Count: > 0 })
{
    @* Problems in the files are surfaced, never thrown: a hand-edited menu that
       cannot be parsed must still leave the rest of the week usable. *@
    <div class="issues">
        <strong>@L["Issues_Title"]</strong>
        <ul>
            @foreach (var issue in Range.Issues)
            {
                <li>@issue.Message</li>
            }
        </ul>
    </div>
}

<div class="menu-grid-scroll">
    <MenuGrid Days="@(Range?.Days ?? [])"
              Slots="@VisibleSlots"
              Markers="@Markers"
              Editable="Editable"
              OnCreate="OnCreate"
              OnEdit="OnEdit"
              OnMoveMenu="OnMoveMenu" />
</div>

<EntryDialog Target="@Editing"
             ReadOnly="@(!Editable)"
             Version="@Range?.Version"
             OnSaved="OnSavedAsync"
             OnCancelled="@(() => Editing = null)" />

<DropChoiceDialog Request="@PendingDrop"
                  OnChosen="OnDropChoiceAsync"
                  OnCancelled="@(() => PendingDrop = null)" />

<MoveToDialog Entry="@Moving"
              OnConfirmed="OnMoveConfirmedAsync"
              OnCancelled="@(() => Moving = null)" />

<RequestPanel Mode="@Panel"
              Requests="@(Range?.Requests ?? [])"
              OnChanged="RefreshAsync"
              OnClosed="@(() => Panel = RequestPanelMode.Closed)" />

@code {
    private DateOnly _start;
    private bool _scrollPending;

    private IReadOnlyList<SlotDefinition> VisibleSlots =>
        SlotVisibility.Visible(AllSlots, Range?.Days ?? [], ShowAllSlots);

    protected override (DateOnly From, DateOnly To) CurrentSpan() => (_start, _start.AddDays(6));

    protected override void InitialiseStart() => _start = StartOfWeek(Today);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_scrollPending)
        {
            _scrollPending = false;
            await Ui.ScrollDayIntoViewAsync(Today);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        ScrollToTodayIfShown();
    }

    // The phone strip opens on Monday, which on a Friday means swiping past
    // four days already eaten. Only on arriving at the week, though: a
    // background refresh yanking the strip back to today would be maddening.
    private void ScrollToTodayIfShown() =>
        _scrollPending = Range?.Days.Any(d => d.Date == Today) == true;

    private async Task ShiftAsync(int days)
    {
        _start = _start.AddDays(days);
        await LoadAsync();
    }

    private async Task GoToTodayAsync()
    {
        _start = StartOfWeek(Today);
        await LoadAsync();
        ScrollToTodayIfShown();
    }

    private string RangeLabel()
    {
        var end = _start.AddDays(6);

        // Only repeat the month and year when the week actually straddles one.
        if (_start.Month == end.Month)
        {
            return $"{_start.Day} – {end:d MMMM yyyy}";
        }

        return _start.Year == end.Year
            ? $"{_start:d MMM} – {end:d MMM yyyy}"
            : $"{_start:d MMM yyyy} – {end:d MMM yyyy}";
    }
}
