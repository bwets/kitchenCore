    private static string? StatusClass(ShoppingItemStatus status) => status switch
    {
        ShoppingItemStatus.Bought => "is-done",
        ShoppingItemStatus.NotFound => "is-done is-not-found",
        ShoppingItemStatus.Refused => "is-done is-refused",
        _ => null,
    };

    /// <summary>Bought shows as the tick; the other two endings need saying.</summary>
