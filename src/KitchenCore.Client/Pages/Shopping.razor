        _renameFocusPending = true;
    }

    private async Task RenameAsync(ShoppingItem item)
    {
        var title = _renameText.Trim();

        // Unchanged is not worth a write, and leaves nothing to commit.
        if (title.Length > 0 && title != item.Title && Scope is { } scope)
        {
            await ApplyAsync(() => Client.RenameItemAsync(scope, item, title));
        }

        if (title.Length > 0)
        {
            _renaming = null;
        }
    }

    private async Task OnRenameKeyAsync(KeyboardEventArgs args, ShoppingItem item)
    {
        if (args.Key == "Enter")
