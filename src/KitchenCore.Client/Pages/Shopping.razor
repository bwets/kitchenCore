    /// <summary>
    /// A picture from the camera or the files: js/photos.js shrinks and sends
    /// it (the bytes never pass through .NET) and hands back the session. The
    /// text in the add box, if any, becomes its title.
    /// </summary>
    private async Task UploadAsync(ElementReference input)
    {
        if (Scope is not { } scope)
        {
            return;
        }

        _uploading = true;
        StateHasChanged();

        try
        {
            _photos ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/photos.js");

            var title = _newItem.Trim();
            var result = await _photos.InvokeAsync<UploadResult?>("upload", input, ShoppingClient.PhotoUploadUrl(scope), title);

            if (result is null)
            {
                return;   // Nothing chosen: the camera was cancelled.
            }

            if (result.Body is { } body && Apply(scope, body))
            {
                _newItem = string.Empty;
                _error = null;
                BuildOptions();
            }
            else
            {
                _error = L[result.Status == 0 ? "Error_Unreachable" : "Shopping_UploadFailed"];
            }
        }
        finally
        {
            _uploading = false;
        }
    }

    private sealed record UploadResult(int Status, string? Body);

    /// <summary>An upload's answer, which is the week or the list it went to, as it now stands.</summary>
    private bool Apply(ShoppingScope scope, string body)
    {
        var options = System.Text.Json.JsonSerializerOptions.Web;

        if (scope.IsWeek)
        {
            _session = System.Text.Json.JsonSerializer.Deserialize<ShoppingSession>(body, options) ?? _session;
            return _session is not null;
        }

        _content = System.Text.Json.JsonSerializer.Deserialize<ShoppingListContent>(body, options) ?? _content;
        return _content is not null;
    }

