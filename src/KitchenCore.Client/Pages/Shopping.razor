@page "/shopping"
@page "/shopping/{ListKey}"
@implements IAsyncDisposable
@inject ShoppingClient Client
@inject AuthService Auth
@inject IJSRuntime JS
@inject UiInterop Ui
@inject IStringLocalizer<Strings> L

@*
    One list per shop, one tab each, defined in config. The weekly one (Auchan)
    is one session at a time: the week's order and delivery, and the list for
    it. The others are a single running list each, bought whenever.

    The weekly list opens on the session new items go to -- the next one not
    ordered yet -- so asking for milk on a Wednesday, after Tuesday's order went
    in, lands on next week's list without anybody having to think about it.

    No categories and no aisles, on purpose: it is a family list, not a store
    layout. Order is whatever the family drags it into.
*@

<PageTitle>@L["Shopping_Title"] · @L["AppName"]</PageTitle>

@if (_lists.Count > 1)
{
    <nav class="list-tabs" role="tablist" aria-label="@L["Shopping_Lists"]">
        @foreach (var summary in _lists)
        {
            var list = summary.List;
            var active = list.Key == _active?.Key;

            <a href="@($"shopping/{list.Key}")" role="tab" aria-selected="@active"
               class="list-tabs__tab @(active ? "is-active" : null)"
               style="@(ShoppingListDefinition.IsValidColor(list.Color) ? $"--shop-color:{list.Color}" : null)">
                <ShopIcon List="@list" />
                <span>@list.Label(CurrentCulture)</span>
                @if (summary.Open > 0)
                {
                    <span class="list-tabs__count">@summary.Open</span>
                }
            </a>
        }
    </nav>
}

<div class="week-bar">
    @if (IsWeekly)
    {
        <button type="button" class="week-bar__button" @onclick="() => ShiftAsync(-7)" title="@L["Shopping_PreviousWeek"]">‹</button>
        <button type="button" class="week-bar__button" @onclick="GoToCurrentAsync">@L["Shopping_Current"]</button>
        <button type="button" class="week-bar__button" @onclick="() => ShiftAsync(7)" title="@L["Shopping_NextWeek"]">›</button>

        <span class="week-bar__range">@WeekLabel()</span>
    }
    else
    {
        <span class="week-bar__note">@L["Shopping_AdHocHint"]</span>
    }
    <span class="week-bar__spacer"></span>

    <MenuTools Loading="_loading" OnRefresh="RefreshAsync" />
</div>

@if (_error is { Length: > 0 })
{
    <div class="issues">@_error</div>
}

@if (Loaded)
{
    <div class="shopping @(IsWeekly ? null : "shopping--single")">
        @if (IsWeekly && _session is { } session)
        {
            <section class="card shopping__trip">
                <header class="shopping__trip-head">
                    <h2 class="card__title">@L["Shopping_Trip"]</h2>

                    <div class="shopping__badges">
                        @if (session.Trip.Placed)
                        {
                            <span class="badge badge--ok">@L["Shopping_Placed"]</span>
                        }
                        else if (!session.Scheduled)
                        {
                            @* Not set for this week: it follows the last week that was. *@
                            <span class="badge badge--soft" title="@L["Shopping_FollowsHint"]">@L["Shopping_Follows"]</span>
                        }
                        @if (session.Trip.Channel is { Length: > 0 } channel)
                        {
                            <span class="shopping__channel">@channel</span>
                        }
                    </div>
                </header>

                @if (_editingDates)
                {
                    <div class="shopping__dates-form">
                        <label class="field">
                            <span class="field__label">@L["Shopping_Order"]</span>
                            <input type="datetime-local" class="field__input" @bind="_order" @bind:format="yyyy-MM-ddTHH:mm" />
                        </label>

                        <label class="field">
                            <span class="field__label">@L["Shopping_Delivery"]</span>
                            <input type="datetime-local" class="field__input" @bind="_delivery" @bind:format="yyyy-MM-ddTHH:mm" />
                        </label>

                        <label class="field field--check">
                            <input type="checkbox" @bind="_placed" />
                            <span>@L["Shopping_PlacedCheck"]</span>
                        </label>

                        <p class="field__hint">@L["Shopping_CarryHint"]</p>

                        <footer class="dialog__foot">
                            @if (session.Scheduled)
                            {
                                <button type="button" class="button" disabled="@_busy" @onclick="ResetDatesAsync">
                                    @L["Shopping_ResetDates"]
                                </button>
                            }
                            <span class="dialog__spacer"></span>
                            <button type="button" class="button" disabled="@_busy" @onclick="() => _editingDates = false">@L["Cancel"]</button>
                            <button type="button" class="button button--primary"
                                    disabled="@(_busy || _delivery < _order)"
                                    @onclick="SaveDatesAsync">
                                @L["Save"]
                            </button>
                        </footer>
                    </div>
                }
                else
                {
                    <ol class="timeline shopping__timeline">
                        @foreach (var (moment, kind, label) in new[]
                        {
                            (session.Trip.Order, "order", "Shopping_Order"),
                            (session.Trip.Delivery, "delivery", "Shopping_Delivery"),
                        })
                        {
                            <li class="timeline__step timeline__step--@kind">
                                <span class="timeline__dot" aria-hidden="true"></span>
                                <span class="timeline__text">
                                    <span class="timeline__label">@L[label]</span>
                                    <span class="timeline__when">@Format(moment)</span>
                                    <span class="badge @(moment.IsPredicted ? "badge--soft" : "badge--ok") timeline__badge">
                                        @(moment.IsPredicted ? L["Shopping_Predicted"] : L["Shopping_Confirmed"])
                                    </span>
                                </span>
                            </li>
                        }
                    </ol>

                    @if (CanEdit)
                    {
                        <footer class="shopping__trip-actions">
                            <button type="button" class="button" @onclick="StartEditingDates">@L["Shopping_EditDates"]</button>
                            <button type="button" class="button @(session.Trip.Placed ? null : "button--primary")"
                                    disabled="@_busy" @onclick="TogglePlacedAsync">
                                @(session.Trip.Placed ? L["Shopping_Unplace"] : L["Shopping_Place"])
                            </button>
                        </footer>
                    }
                }
            </section>
        }

        <section class="card shopping__list">
            <header class="card__head">
                <h2 class="card__title">
                    @if (!IsWeekly && _active is { } shop)
                    {
                        <ShopIcon List="@shop" Class="shop-icon--title" Size="16" />
                    }
                    @(IsWeekly ? L["Shopping_List"] : _active?.Label(CurrentCulture))
                    @if (Items.Count > 0)
                    {
                        <span class="shopping__count">@DoneCount/@Items.Count</span>
                    }
                </h2>

                <span class="shopping__head-actions">
                    @if (DoneCount > 0 && !IsWeekly && CanEdit)
                    {
                        @* A running list is never "next week"; once the shop has been
                           visited, what was dealt with goes. *@
                        <button type="button" class="shopping__filter" disabled="@_busy" @onclick="ClearSettledAsync">
                            @L["Shopping_ClearDone"]
                        </button>
                    }
                    @if (DoneCount > 0)
                    {
                        <button type="button" class="shopping__filter @(_hideDone ? null : "is-on")"
                                aria-pressed="@(!_hideDone)"
                                @onclick="() => _hideDone = !_hideDone">
                            @(_hideDone ? string.Format(L["Shopping_ShowDone"], DoneCount) : L["Shopping_HideDone"])
                        </button>
                    }
                </span>
            </header>

            @if (CanRequest)
            {
                @if (IsWeekly && _session?.Trip.Placed == true)
                {
                    <p class="field__hint">@L["Shopping_AlreadyPlaced"]</p>
                }

                <div class="shopping__add" @onfocusout="CloseSuggestions">
                    <div class="suggest">
                        <input class="field__input" placeholder="@L["Shopping_AddPlaceholder"]"
                               role="combobox" aria-autocomplete="list" aria-expanded="@SuggestionsShown"
                               autocomplete="off"
                               value="@_newItem"
                               @onfocus="OpenSuggestionsAsync"
                               @onclick="OpenSuggestionsAsync"
                               @oninput="OnAddInput"
                               @onkeydown="OnAddKeyDown" />

                        @if (SuggestionsShown)
                        {
                            var index = 0;

                            @* mousedown is swallowed so the input keeps focus: picking one item
                               leaves the list open for the next. *@
                            <div class="suggest__panel" role="listbox" @onmousedown:preventDefault>
                                @foreach (var group in _options)
                                {
                                    @if (group.Label is { } label)
                                    {
                                        <div class="suggest__group">@label</div>
                                    }

                                    @foreach (var suggestion in group.Items)
                                    {
                                        var at = index++;
                                        <button type="button" role="option" tabindex="-1"
                                                class="suggest__option @(at == _highlight ? "is-active" : null)"
                                                aria-selected="@(at == _highlight)"
                                                @onclick="() => PickAsync(suggestion)">
                                            @if (suggestion.Photo is { } photo)
                                            {
                                                <ShoppingPhoto Path="@photo" Class="suggest__thumb" />
                                            }
                                            <span>@suggestion.Title</span>
                                        </button>
                                    }
                                }
                            </div>
                        }
                    </div>

                    <button type="button" class="button button--primary"
                            disabled="@(_busy || string.IsNullOrWhiteSpace(_newItem))"
                            @onclick="() => AddAsync()">
                        @L["Shopping_Add"]
                    </button>
                </div>

                @* Labels wrapping the inputs: one tap opens the camera or the picker,
                   and the picture goes up as soon as it is chosen, with no confirm step.
                   Whatever is typed in the box becomes its title. *@
                <div class="shopping__snap">
                    <label class="snap-button snap-button--camera @(_uploading ? "is-busy" : null)">
                        <input type="file" accept="image/*" capture="environment" class="visually-hidden"
                               disabled="@_uploading" @ref="_cameraInput"
                               @onchange="() => UploadAsync(_cameraInput)" />
                        <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true">
                            <path d="M4 8h3l1.6-2.4h6.8L17 8h3v11H4z" />
                            <circle cx="12" cy="13.2" r="3.6" />
                        </svg>
                        <span>@(_uploading ? L["Shopping_Uploading"] : L["Shopping_TakePhoto"])</span>
                    </label>

                    <label class="snap-button @(_uploading ? "is-busy" : null)">
                        <input type="file" accept="image/*" multiple class="visually-hidden"
                               disabled="@_uploading" @ref="_fileInput"
                               @onchange="() => UploadAsync(_fileInput)" />
                        <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true">
                            <rect x="3.5" y="4.5" width="17" height="15" rx="2" />
                            <circle cx="9" cy="9.5" r="1.6" />
                            <path d="M4 17l5-5 4 4 2.5-2.5L20 17" />
                        </svg>
                        <span>@(_uploading ? L["Shopping_Uploading"] : L["Shopping_AddPicture"])</span>
                    </label>
                </div>
            }

            @if (Items.Count == 0)
            {
                <p class="muted">@L["Shopping_Empty"]</p>
            }
            else if (_hideDone && DoneCount == Items.Count)
            {
                <p class="muted">@L["Shopping_AllDone"]</p>
            }

            <ul class="shopping__items" data-sort-list @ref="_list">
                @foreach (var item in Items.Where(i => !_hideDone || !i.Done))
                {
                    <li class="shopping-item @StatusClass(item.Status)" data-sort-item="@item.Ordinal"
                        @key="(item.Ordinal, item.Title)">
                        @if (CanRequest)
                        {
                            <span class="shopping-item__handle" data-sort-handle title="@L["Shopping_DragHint"]" aria-hidden="true">
                                <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor">
                                    <circle cx="9" cy="6" r="1.6" /><circle cx="15" cy="6" r="1.6" />
                                    <circle cx="9" cy="12" r="1.6" /><circle cx="15" cy="12" r="1.6" />
                                    <circle cx="9" cy="18" r="1.6" /><circle cx="15" cy="18" r="1.6" />
                                </svg>
                            </span>
                        }

                        @if (CanEdit)
                        {
                            @* The common case, bought, stays one tap; the rest is in the menu. *@
                            <input type="checkbox" class="shopping-item__check"
                                   checked="@(item.Status == ShoppingItemStatus.Bought)"
                                   aria-label="@L["Shopping_MarkDone"]"
                                   @onchange="e => SetStatusAsync(item, (bool?)e.Value == true ? ShoppingItemStatus.Bought : ShoppingItemStatus.Open)" />
                        }
                        else if (item.Status == ShoppingItemStatus.Bought)
                        {
                            <span class="shopping-item__tick" aria-label="@L["Shopping_Done"]">✓</span>
                        }

                        @if (item.Photo is { } photo)
                        {
                            <button type="button" class="shopping-item__photo"
                                    aria-label="@L["Shopping_ShowPhoto"]" @onclick="() => _lightbox = photo">
                                <ShoppingPhoto Path="@photo" Alt="@item.Title" />
                            </button>
                        }

                        @if (IsRenaming(item))
                        {
                            <span class="shopping-item__rename">
                                <input class="field__input" @ref="_renameField"
                                       aria-label="@L["Shopping_Rename"]"
                                       value="@_renameText"
                                       @oninput="e => _renameText = e.Value?.ToString() ?? string.Empty"
                                       @onkeydown="e => OnRenameKeyAsync(e, item)" />
                                <button type="button" class="button button--primary"
                                        disabled="@(_busy || string.IsNullOrWhiteSpace(_renameText))"
                                        @onclick="() => RenameAsync(item)">@L["Save"]</button>
                                <button type="button" class="button" @onclick="() => _renaming = null">@L["Cancel"]</button>
                            </span>
                        }
                        else
                        {
                            <span class="shopping-item__title">
                                @item.Title
                                @if (StatusLabel(item.Status) is { } status)
                                {
                                    <span class="badge shopping-item__status">@status</span>
                                }
                            </span>

                            @if (!string.IsNullOrWhiteSpace(item.By))
                            {
                                @* Initials, with the name on hover: who asked matters,
                                   but not as much as what. *@
                                <span class="shopping-item__by" title="@item.By" aria-label="@item.By">@Initials(item.By)</span>
                            }
                        }

                        @if (IsRenaming(item))
                        {
                            @* The row is the editor for now; no menu beside it. *@
                        }
                        else if (CanEdit || CanRename(item))
                        {
                            <span class="shopping-item__menu-anchor">
                                <button type="button" class="shopping-item__more"
                                        aria-label="@L["Shopping_More"]" aria-haspopup="menu"
                                        aria-expanded="@IsMenuOpen(item)"
                                        @onclick="() => ToggleMenu(item)">
                                    <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
                                        <circle cx="12" cy="5.5" r="1.8" /><circle cx="12" cy="12" r="1.8" /><circle cx="12" cy="18.5" r="1.8" />
                                    </svg>
                                </button>

                                @if (IsMenuOpen(item))
                                {
                                    <div class="item-menu__scrim" @onclick="() => _menuFor = null"></div>
                                    <div class="item-menu" role="menu" @ref="_menuRef">
                                        @if (CanRename(item))
                                        {
                                            <button type="button" role="menuitem" @onclick="() => StartRenaming(item)">@L["Shopping_Rename"]</button>
                                        }
                                        @if (CanEdit)
                                        {
                                            @if (item.Status != ShoppingItemStatus.NotFound)
                                            {
                                                <button type="button" role="menuitem" @onclick="() => SetStatusAsync(item, ShoppingItemStatus.NotFound)">@L["Shopping_MarkNotFound"]</button>
                                            }
                                            @if (item.Status != ShoppingItemStatus.Refused)
                                            {
                                                <button type="button" role="menuitem" @onclick="() => SetStatusAsync(item, ShoppingItemStatus.Refused)">@L["Shopping_MarkRefused"]</button>
                                            }
                                            @if (item.Done)
                                            {
                                                <button type="button" role="menuitem" @onclick="() => SetStatusAsync(item, ShoppingItemStatus.Open)">@L["Shopping_Reopen"]</button>
                                            }
                                            @if (IsWeekly)
                                            {
                                                <button type="button" role="menuitem" @onclick="() => PostponeAsync(item)">@L["Shopping_Postpone"]</button>
                                            }
                                        }
                                        @if (CanRemove(item) && Destinations.Count > 0)
                                        {
                                            <div class="item-menu__group" role="presentation">@L["Shopping_MoveTo"]</div>
                                            @foreach (var destination in Destinations)
                                            {
                                                <button type="button" role="menuitem" @onclick="() => TransferAsync(item, destination.Key)">
                                                    @destination.Label(CurrentCulture)
                                                </button>
                                            }
                                        }
                                        @if (CanRemove(item))
                                        {
                                            <button type="button" role="menuitem" class="item-menu__danger" @onclick="() => RemoveAsync(item)">@L["Shopping_Remove"]</button>
                                        }
                                    </div>
                                }
                            </span>
                        }
                    </li>
                }
            </ul>
        </section>
    </div>

    @if (_lightbox is { } full)
    {
        <div class="lightbox" role="dialog" aria-modal="true" tabindex="-1" @ref="_lightboxRef"
             @onclick="() => _lightbox = null" @onkeydown="OnLightboxKey">
            <div class="lightbox__stage" data-zoom-stage @ref="_lightboxStage">
                <ShoppingPhoto Path="@full" Class="lightbox__img" />
            </div>
            @* js/zoom.js handles the zoom buttons and stops their clicks; the close
               button's click bubbles up to the dialog and closes it. *@
            <div class="lightbox__tools">
                <button type="button" class="lightbox__tool" data-zoom="out" aria-label="@L["Shopping_ZoomOut"]">−</button>
                <button type="button" class="lightbox__tool" data-zoom="fit" aria-label="@L["Shopping_ZoomFit"]">
                    <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none"
                         stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" />
                    </svg>
                </button>
                <button type="button" class="lightbox__tool" data-zoom="in" aria-label="@L["Shopping_ZoomIn"]">+</button>
                <button type="button" class="lightbox__tool" aria-label="@L["Close"]">×</button>
            </div>
        </div>
    }
}
else if (_loading)
{
    <p class="loading">@L["Loading"]</p>
}

@code {
    /// <summary>The tab, from the URL. None means the first list in config.</summary>
    [Parameter]
    public string? ListKey { get; set; }

    private List<ShoppingListSummary> _lists = [];
    private ShoppingListDefinition? _active;
    private bool _sortAttached;

    // The weekly list's state; _content is an ad hoc list's.
    private ShoppingSession? _session;
    private ShoppingListContent? _content;
    private DateOnly? _week;
    private bool _loading = true;
    private bool _busy;
    private string? _error;
    private string _newItem = string.Empty;

    private bool _editingDates;
    private DateTime _order;
    private DateTime _delivery;
    private bool _placed;

    private ElementReference _list;
    private IJSObjectReference? _sortable;
    private DotNetObjectReference<Shopping>? _self;
    private readonly string _sortId = Guid.NewGuid().ToString("N");
    private AutoRefresh? _autoRefresh;

    // Ticked-off items are out of the way by default: the list is what is still to get.
    private bool _hideDone = true;

    // The add box's suggestions: fetched once per week or list, filtered here as the person types.
    private ShoppingSuggestions? _suggestions;
    private ShoppingScope? _suggestionsFor;
    private bool _suggestOpen;
    private List<SuggestionGroup> _options = [];
    private int _highlight = -1;

    private const int MaxMatches = 12;

    private sealed record SuggestionGroup(string? Label, IReadOnlyList<ShoppingSuggestion> Items);

    // Pictures: the two hidden file inputs behind the big buttons, and the one shown full screen.
    private ElementReference _cameraInput;
    private ElementReference _fileInput;
    private IJSObjectReference? _photos;
    private bool _uploading;
    private string? _lightbox;
    private ElementReference _lightboxRef;
    private ElementReference _lightboxStage;
    private bool _lightboxFocused;
    private IJSObjectReference? _zoom;

    // The item whose action menu is open, by the same (ordinal, title) pair that addresses it.
    private (int Ordinal, string Title)? _menuFor;

    private ElementReference _menuRef;
    private bool _menuPlacePending;

    // The item being retitled in place, addressed the same way.
    private (int Ordinal, string Title)? _renaming;
    private string _renameText = string.Empty;
    private ElementReference _renameField;
    private bool _renameFocusPending;

    /// <summary>No lists from the server (an old one, or a failure) means the weekly list alone, as before.</summary>
    private bool IsWeekly => _active is null || _active.Weekly;

    private IReadOnlyList<ShoppingItem> Items => (IsWeekly ? _session?.Items : _content?.Items) ?? [];

    private bool Loaded => IsWeekly ? _session is not null : _content is not null;

    /// <summary>Where item writes go: the shown week, or the shown ad hoc list.</summary>
    private ShoppingScope? Scope => IsWeekly
        ? _week is { } week ? ShoppingScope.Week(week) : null
        : ShoppingScope.List(_active!.Key);

    /// <summary>
    /// The lists an item here can be moved to: every other tab. Between two
    /// weeks of the weekly list it is "move to next week" instead.
    /// </summary>
    private IReadOnlyList<ShoppingListDefinition> Destinations =>
        [.. _lists.Select(s => s.List).Where(l => l.Key != _active?.Key && !(IsWeekly && l.Weekly))];

    private int DoneCount => Items.Count(i => i.Done);

    private bool SuggestionsShown => _suggestOpen && _options.Count > 0;

    private bool CanEdit => Auth.Identity.CanEdit(Section.Shopping);

    private bool CanRequest => Auth.Identity.CanRequest(Section.Shopping);

    private bool IsMine(ShoppingItem item) =>
        CanRequest && string.Equals(item.By, Auth.Identity.Name, StringComparison.Ordinal);

    /// <summary>Editors remove anything; everyone else only what they added.</summary>
    private bool CanRemove(ShoppingItem item) => CanEdit || IsMine(item);

    /// <summary>Admins retitle anything; everyone else only what they added.</summary>
    private bool CanRename(ShoppingItem item) => (Auth.Identity.Admin && CanRequest) || IsMine(item);

    private static string CurrentCulture =>
        System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _lists = await Client.ListsAsync();
        }
        catch (ApiException)
        {
            // Without the tabs the weekly list still works on its own.
            _lists = [];
        }

        _autoRefresh = new AutoRefresh(JS);
        await _autoRefresh.StartAsync(
            () => InvokeAsync(() => LoadAsync(quiet: true)),
            () => !_editingDates && !_busy && !_uploading && _menuFor is null && _renaming is null && _lightbox is null);
    }

    /// <summary>Switching tabs is a navigation: the same page, another list.</summary>
    protected override async Task OnParametersSetAsync()
    {
        var active = _lists.FirstOrDefault(l => l.List.Key == ListKey)?.List ?? _lists.FirstOrDefault()?.List;

        if (_active is not null && active?.Key == _active.Key && Loaded)
        {
            return;
        }

        _active = active;
        _session = null;
        _content = null;
        _week = null;
        _suggestions = null;
        _options = [];
        _newItem = string.Empty;
        _hideDone = true;
        _menuFor = null;
        _renaming = null;
        _editingDates = false;
        _sortAttached = false;

        await LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // The list element exists only once a list has rendered, and is a new
        // element after a tab switch, so attach whenever it has not been yet.
        if (!_sortAttached && Loaded && CanRequest)
        {
            _sortAttached = true;
            _self ??= DotNetObjectReference.Create(this);
            _sortable ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/sortable.js");
            await _sortable.InvokeVoidAsync("attach", _sortId, _list, _self);
        }

        if (_menuPlacePending && _menuFor is not null)
        {
            _menuPlacePending = false;
            await Ui.PlaceMenuAsync(_menuRef);
        }

        if (_renameFocusPending)
        {
            _renameFocusPending = false;
            await _renameField.FocusAsync();
        }

        // Focused once it opens, so Escape reaches it, and handed to js/zoom.js.
        if (_lightbox is not null && !_lightboxFocused)
        {
            _lightboxFocused = true;
            await _lightboxRef.FocusAsync();
            _zoom ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/zoom.js");
            await _zoom.InvokeVoidAsync("attach", _lightboxStage);
        }
        else if (_lightbox is null && _lightboxFocused)
        {
            _lightboxFocused = false;

            if (_zoom is not null)
            {
                await _zoom.InvokeVoidAsync("detach");
            }
        }
    }

    /// <summary>
    /// Loads the shown list: on the weekly one the chosen week, or -- before
    /// one is chosen -- the session new items should go to.
    /// </summary>
    private async Task LoadAsync(bool quiet = false)
    {
        if (!quiet)
        {
            _loading = true;
        }

        try
        {
            if (IsWeekly)
            {
                _session = _week is { } week ? await Client.SessionAsync(week) : await Client.CurrentAsync();
                _week = _session.Week;
            }
            else
            {
                _content = await Client.ListAsync(_active!.Key);
            }

            _error = null;
        }
        catch (ApiException ex)
        {
            _error = L[ex.ResourceKey];
        }

        if (quiet)
        {
            await RefreshCountsAsync();
        }

        _loading = false;
        StateHasChanged();
    }

    /// <summary>The tabs' counts, after anything that may have changed them.</summary>
    private async Task RefreshCountsAsync()
    {
        if (_lists.Count == 0)
        {
            return;
        }

        try
        {
            _lists = await Client.ListsAsync();
        }
        catch (ApiException)
        {
            // Stale counts are fine until the next refresh.
        }
    }

    private async Task RefreshAsync()
    {
        await RefreshCountsAsync();
        await LoadAsync();
    }

    private async Task ShiftAsync(int days)
    {
        if (_week is { } week)
        {
            _week = week.AddDays(days);
            _editingDates = false;
            await LoadAsync();
        }
    }

    private async Task GoToCurrentAsync()
    {
        _week = null;
        _editingDates = false;
        await LoadAsync();
    }

    /// <summary>Applies a write's answer, which is the session as it now stands.</summary>
    private async Task ApplyAsync(Func<Task<ShoppingOutcome>> write)
    {
        _busy = true;

        try
        {
            var outcome = await write();

            if (outcome.Success)
            {
                _session = outcome.Session ?? _session;
                _content = outcome.List ?? _content;
                _error = null;
                await RefreshCountsAsync();
            }
            else
            {
                _error = outcome.ResourceKey is { Length: > 0 } key ? L[key].Value : null;

                // Most likely the list moved under us: show what is there now.
                await LoadAsync(quiet: true);
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task OnAddKeyDown(KeyboardEventArgs args)
    {
        var count = _options.Sum(g => g.Items.Count);

        switch (args.Key)
        {
            case "ArrowDown" when count > 0:
                _suggestOpen = true;
                _highlight = (_highlight + 1) % count;
                break;

            case "ArrowUp" when count > 0:
                _suggestOpen = true;
                _highlight = _highlight <= 0 ? count - 1 : _highlight - 1;
                break;

            case "Escape":
                _suggestOpen = false;
                _highlight = -1;
                break;

            case "Enter":
                if (SuggestionsShown && _highlight >= 0 && _options.SelectMany(g => g.Items).ElementAtOrDefault(_highlight) is { } picked)
                {
                    await PickAsync(picked);
                }
                else
                {
                    await AddAsync();
                }
                break;
        }
    }

    private void OnAddInput(ChangeEventArgs e)
    {
        _newItem = e.Value?.ToString() ?? string.Empty;
        _suggestOpen = true;
        BuildOptions();
    }

    private async Task OpenSuggestionsAsync()
    {
        _suggestOpen = true;

        if (Scope is { } scope && (_suggestions is null || _suggestionsFor != scope))
        {
            _suggestionsFor = scope;
            _suggestions = await Client.SuggestionsAsync(scope);
        }

        BuildOptions();
    }

    private void CloseSuggestions()
    {
        _suggestOpen = false;
        _highlight = -1;
    }

    /// <summary>
    /// Empty box: the last few weeks, grouped by week, most recent first. Once
    /// something is typed: every past title that matches. Either way, nothing
    /// already on this week's list -- loosely matched, see ShoppingTitles.
    /// </summary>
    private void BuildOptions()
    {
        _highlight = -1;

        if (_suggestions is null)
        {
            _options = [];
            return;
        }

        var onList = Items.Select(i => ShoppingTitles.Key(i.Title)).ToHashSet();
        var typed = ShoppingTitles.Key(_newItem);

        if (typed.Length == 0)
        {
            _options =
            [
                .. _suggestions.Recent
                    .Select(w => new SuggestionGroup(
                        string.Format(L["Shopping_WeekOf"], w.Week.ToString("d MMMM")),
                        [.. w.Items.Where(s => !onList.Contains(ShoppingTitles.Key(s.Title)))]))
                    .Where(g => g.Items.Count > 0),
            ];
            return;
        }

        // Words that start the title rank above words found inside it.
        var matches = _suggestions.All
            .Select(s => (Suggestion: s, Key: ShoppingTitles.Key(s.Title)))
            .Where(t => !onList.Contains(t.Key) && t.Key.Contains(typed, StringComparison.Ordinal))
            .OrderBy(t => t.Key.StartsWith(typed, StringComparison.Ordinal) ? 0 : 1)
            .Take(MaxMatches)
            .Select(t => t.Suggestion)
            .ToList();

        _options = matches.Count > 0 ? [new SuggestionGroup(null, matches)] : [];
    }

    /// <summary>A past item, picture and all: the file is pointed at, not copied.</summary>
    private async Task PickAsync(ShoppingSuggestion suggestion)
    {
        _newItem = suggestion.Title;
        await AddAsync(suggestion.Photo);
    }

    private async Task AddAsync() => await AddAsync(photo: null);

    private async Task AddAsync(string? photo)
    {
        if (Scope is not { } scope || string.IsNullOrWhiteSpace(_newItem))
        {
            return;
        }

        var title = _newItem.Trim();
        _newItem = string.Empty;
        await ApplyAsync(() => Client.AddItemAsync(scope, title, photo));

        // What was just added drops out of the suggestions.
        BuildOptions();
    }

