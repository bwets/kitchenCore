@page "/"
@inject MenuClient Menu
@inject SystemStatusService Status
@inject IShoppingSchedule Shopping
@inject IStringLocalizer<Strings> L

<PageTitle>@L["AppName"]</PageTitle>

<div class="cards">

    @* Today's menu. The card people actually open the app for. *@
    <article class="card card--menu">
        <header class="card__head">
            <div>
                <h2 class="card__title">@L["Home_TodayMenu"]</h2>
                <p class="card__subtitle">@Today.ToString("dddd d MMMM")</p>
            </div>
            <a class="card__action" href="/menu/week">@L["Home_OpenWeek"]</a>
        </header>

        @if (_today is null)
        {
            <p class="loading">@L["Loading"]</p>
        }
        else if (_slots.Count == 0)
        {
            <p class="muted">@L["Home_NothingPlanned"]</p>
        }
        else
        {
            <ul class="today">
                @foreach (var slot in _slots)
                {
                    var cell = CellFor(slot.Key);

                    <li class="today__row @SlotTone.CssClass(slot.Key)">
                        <span class="slot-label">@slot.Label(CurrentCulture)</span>

                        @if (cell is null || cell.IsEmpty)
                        {
                            <span class="today__empty">@L["Home_NoEntry"]</span>
                        }
                        else
                        {
                            <span class="today__titles">
                                @foreach (var entry in cell.Entries)
                                {
                                    <span class="today__title">@entry.Title</span>
                                }
                            </span>

                            @if (cell.IsDuplicated)
                            {
                                @* Two entries in one slot: flagged, never silently merged. *@
                                <span class="badge badge--error" title="@L["Duplicate_Hint"]">@L["Duplicate_Short"]</span>
                            }
                        }
                    </li>
                }
            </ul>
        }
    </article>

    @* Next shopping trip. Two moments, both predicted until the order is placed. *@
    <article class="card card--shopping">
        <header class="card__head">
            <div>
                <h2 class="card__title">@L["Home_NextShopping"]</h2>
                @if (_trip?.Channel is { Length: > 0 } channel)
                {
                    <p class="card__subtitle">@channel</p>
                }
            </div>
            <span class="badge badge--soft">@L["Placeholder"]</span>
        </header>

        @if (_trip is null)
        {
            <p class="loading">@L["Loading"]</p>
        }
        else
        {
            <ul class="moments">
                <li class="moment moment--order">
                    <span class="moment__rule" aria-hidden="true"></span>
                    <span class="moment__label">@L["Shopping_Order"]</span>
                    <span class="moment__when">@Format(_trip.Order)</span>
                    @if (_trip.Order.IsPredicted)
                    {
                        <span class="badge badge--soft">@L["Shopping_Predicted"]</span>
                    }
                </li>

                <li class="moment moment--delivery">
                    <span class="moment__rule" aria-hidden="true"></span>
                    <span class="moment__label">@L["Shopping_Delivery"]</span>
                    <span class="moment__when">@Format(_trip.Delivery)</span>
                    @if (_trip.Delivery.IsPredicted)
                    {
                        <span class="badge badge--soft">@L["Shopping_Predicted"]</span>
                    }
                </li>
            </ul>

            <p class="card__note">@L["Shopping_MarkerHint"]</p>
        }
    </article>

</div>

@code {
    private MenuRangeResponse? _today;
    private ShoppingTrip? _trip;
    private IReadOnlyList<SlotDefinition> _slots = [];

    private static DateOnly Today => DateOnly.FromDateTime(DateTime.Now);

    private static string CurrentCulture =>
        System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;

    protected override async Task OnInitializedAsync()
    {
        _slots = (await Status.GetAsync()).Slots;
        _trip = await Shopping.NextTripAsync();
        _today = await Menu.DayAsync(Today);
    }

    private MenuCell? CellFor(string slot) => _today?
        .Days.FirstOrDefault()?
        .Cells.FirstOrDefault(c => string.Equals(c.Slot, slot, StringComparison.OrdinalIgnoreCase));

    /// <summary>Both date and time matter here, so both are shown.</summary>
    private static string Format(ShoppingMoment moment) =>
        moment.At.ToString("ddd d MMM, HH:mm");
}
