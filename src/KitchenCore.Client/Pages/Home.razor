@page "/"
@inject MenuClient Menu
@inject SystemStatusService Status
@inject IShoppingSchedule Shopping
@inject ShoppingClient ShoppingLists
@inject AuthService Auth
@inject EditMode EditMode
@inject IStringLocalizer<Strings> L

@*
    The dashboard: what is on the table today, and when the food arrives.

    Today's first planned meal is the large card -- it is what the app gets
    opened for -- with the day's other slots under it and tomorrow in one line.
    Shopping is a timeline of the next order and delivery, and what is still
    to get on each list.
*@

<PageTitle>@L["AppName"]</PageTitle>

<div class="home">
    <header class="home__head">
        <p class="home__date">@Today.ToString("dddd d MMMM")</p>
        <h1 class="home__greeting">@Greeting()</h1>
    </header>

    <div class="home__columns">
        <section class="card home__today">
            <header class="card__head">
                <h2 class="card__title">@L["Home_OnTheTable"]</h2>
                <a class="card__link" href="/menu/week">@L["Home_OpenWeek"] →</a>
            </header>

            @if (_days is null)
            {
                <p class="loading">@L["Loading"]</p>
            }
            else if (_slots.Count == 0)
            {
                <p class="muted">@L["Home_NothingPlanned"]</p>
            }
            else
            {
                var hero = Hero();

                @if (hero is { } main)
                {
                    <button type="button" class="hero @SlotTone.CssClass(main.Slot)" @onclick="() => _open = main">
                        <span class="hero__top">
                            <span class="slot-tag">
                                <span class="slot-tag__swatch" aria-hidden="true"></span>
                                @SlotLabel(main.Slot)
                            </span>
                            @if (main.Entry.Links.Count > 0)
                            {
                                <span class="hero__hint">@L["Grid_Link"]</span>
                            }
                        </span>
                        <span class="hero__title">@main.Entry.Title</span>
                        @if (Summary(main.Entry.Notes) is { Length: > 0 } summary)
                        {
                            <span class="hero__summary">@summary</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(main.Entry.Notes) || main.Entry.Links.Count > 0)
                        {
                            <span class="hero__more">@L["Home_ReadMore"]</span>
                        }
                    </button>
                }
                else
                {
                    <p class="muted">@L["Home_NothingPlanned"]</p>
                }

                <ul class="meal-tiles">
                    @foreach (var slot in _slots.Where(s => !string.Equals(s.Key, hero?.Slot, StringComparison.OrdinalIgnoreCase)))
                    {
                        var cell = CellFor(Today, slot.Key);

                        <li class="meal-tile @SlotTone.CssClass(slot.Key)">
                            <span class="slot-tag">
                                <span class="slot-tag__swatch" aria-hidden="true"></span>
                                @slot.Label(CurrentCulture)
                                @if (cell?.IsDuplicated == true)
                                {
                                    @* Two entries in one slot: flagged, never silently merged. *@
                                    <span class="badge badge--error" title="@L["Duplicate_Hint"]">@L["Duplicate_Short"]</span>
                                }
                            </span>

                            @if (cell is null || cell.IsEmpty)
                            {
                                <span class="meal-tile__empty">@L["Home_NothingPlanned"]</span>
                            }
                            else
                            {
                                @for (var i = 0; i < cell.Entries.Count; i++)
                                {
                                    var target = new MenuEntryRef(Today, slot.Key, i, cell.Entries[i]);

                                    <button type="button" class="meal-tile__title" @onclick="() => _open = target">
                                        @target.Entry.Title
                                    </button>
                                }
                            }
                        </li>
                    }
                </ul>

                @if (TomorrowLine() is { Length: > 0 } tomorrow)
                {
                    <p class="home__tomorrow"><strong>@L["Home_Tomorrow"]</strong> · @tomorrow</p>
                }
            }
        </section>

        <div class="home__side">
            @* Next shopping trip. Two moments, both predicted until the order is placed. *@
            <section class="card">
                <header class="card__head">
                    <h2 class="card__title">@L["Home_NextShopping"]</h2>
                    @if (_trip?.Channel is { Length: > 0 } channel)
                    {
                        <span class="card__meta">@channel</span>
                    }
                </header>

                @if (!_tripLoaded)
                {
                    <p class="loading">@L["Loading"]</p>
                }
                else if (_trip is null)
                {
                    <p class="muted">@L["Error_Unreachable"]</p>
                }
                else
                {
                    <ol class="timeline">
                        @foreach (var (moment, kind, label) in new[]
                        {
                            (_trip.Order, "order", "Shopping_Order"),
                            (_trip.Delivery, "delivery", "Shopping_Delivery"),
                        })
                        {
                            <li class="timeline__step timeline__step--@kind">
                                <span class="timeline__dot" aria-hidden="true"></span>
                                <span class="timeline__text">
                                    <span class="timeline__label">@L[label]</span>
                                    <span class="timeline__when">@Format(moment)</span>
                                    <span class="timeline__state">@(moment.IsPredicted ? L["Shopping_Predicted"] : L["Shopping_Confirmed"])</span>
                                </span>
                            </li>
                        }
                    </ol>
                }
            </section>

            @if (_lists.Count > 0)
            {
                <section class="card">
                    <header class="card__head">
                        <h2 class="card__title">@L["Home_StillToGet"]</h2>
                        <a class="card__link" href="shopping">@L["Home_OpenShopping"] →</a>
                    </header>

                    <ul class="list-counts">
                        @foreach (var summary in _lists)
                        {
                            <li>
                                <a class="list-counts__row" href="@($"shopping/{summary.List.Key}")">
                                    <span class="list-counts__name"><ShopIcon List="@summary.List" />@summary.List.Label(CurrentCulture)</span>
                                    <span class="list-counts__count @(summary.Open == 0 ? "is-zero" : null)">
                                        @(summary.Open == 0 ? L["Home_NothingToGet"] : string.Format(L["Home_ItemCount"], summary.Open))
                                    </span>
                                </a>
                            </li>
                        }
                    </ul>
                </section>
            }
        </div>
    </div>
</div>

@* The same details as from the menu views, and the same rule: an editor edits
   here only with edit mode on. *@
<EntryDialog Target="@_open"
             ReadOnly="@(!EditMode.On)"
             Version="@_version"
             OnSaved="OnSavedAsync"
             OnCancelled="@(() => _open = null)" />

@code {
    private IReadOnlyList<MenuDay>? _days;
    private string? _version;
    private MenuEntryRef? _open;
    private ShoppingTrip? _trip;
    private bool _tripLoaded;
    private IReadOnlyList<SlotDefinition> _slots = [];
    private IReadOnlyList<ShoppingListSummary> _lists = [];

    private const int SummaryLength = 140;

    private static DateOnly Today => DateOnly.FromDateTime(DateTime.Now);

    private static string CurrentCulture =>
        System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;

    protected override async Task OnInitializedAsync()
    {
        _slots = (await Status.GetAsync()).Slots;
        _trip = await Shopping.NextTripAsync();
        _tripLoaded = true;
        await LoadDaysAsync();

        // The lists need shopping access, which not every device has.
        if (Auth.Identity.CanView(Section.Shopping))
        {
            try
            {
                _lists = await ShoppingLists.ListsAsync();
            }
            catch (ApiException)
            {
                _lists = [];
            }
        }
    }

    private async Task LoadDaysAsync()
    {
        var range = await Menu.RangeAsync(Today, Today.AddDays(1));
        _days = range.Days;
        _version = range.Version;
    }

    private async Task OnSavedAsync()
    {
        _open = null;
        await LoadDaysAsync();
    }

    private string Greeting()
    {
        var hour = DateTime.Now.Hour;
        var hello = L[hour < 12 ? "Home_Morning" : hour < 18 ? "Home_Afternoon" : "Home_Evening"].Value;

        return Auth.Identity.Name is { Length: > 0 } name ? $"{hello}, {name}" : hello;
    }

    /// <summary>Today's first planned meal, in slot order: the one the card leads with.</summary>
    private MenuEntryRef? Hero()
    {
        foreach (var slot in _slots)
        {
            if (CellFor(Today, slot.Key) is { IsEmpty: false } cell)
            {
                return new MenuEntryRef(Today, slot.Key, 0, cell.Entries[0]);
            }
        }

        return null;
    }

    /// <summary>The notes' first lines as one, without the markdown marks: a taste, not the recipe.</summary>
    private static string? Summary(string? notes)
    {
        if (string.IsNullOrWhiteSpace(notes))
        {
            return null;
        }

        var lines = notes
            .Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Select(l => l.TrimStart('#', '-', '*', '>', ' ').Trim())
            .Where(l => l.Length > 0);

        var text = string.Join(" · ", lines);
        return text.Length <= SummaryLength ? text : text[..SummaryLength].TrimEnd() + "…";
    }

    private string? TomorrowLine()
    {
        var titles = _slots
            .Select(s => CellFor(Today.AddDays(1), s.Key))
            .Where(c => c is { IsEmpty: false })
            .SelectMany(c => c!.Entries.Select(e => e.Title))
            .ToList();

        return titles.Count > 0 ? string.Join(" · ", titles) : null;
    }

    private string SlotLabel(string key) =>
        _slots.FirstOrDefault(s => string.Equals(s.Key, key, StringComparison.OrdinalIgnoreCase))?.Label(CurrentCulture) ?? key;

    private MenuCell? CellFor(DateOnly date, string slot) => _days?
        .FirstOrDefault(d => d.Date == date)?
        .Cells.FirstOrDefault(c => string.Equals(c.Slot, slot, StringComparison.OrdinalIgnoreCase));

    /// <summary>Both date and time matter here, so both are shown.</summary>
    private static string Format(ShoppingMoment moment) =>
        moment.At.ToString("dddd d MMM, HH:mm");
}
