@page "/menu/multi-week"
@inherits MenuViewBase

@*
    Several weeks at once, for moving meals around.

    Reuses MenuGrid one week band at a time rather than rendering one long grid:
    the slot rows have to stay aligned *within* a week, but a band per week keeps
    the day-of-week columns lined up down the page, which is what makes dragging
    "the same dinner, a week later" straightforward. It is also the natural
    place to schedule requests, so the request sidebar is here as well.
*@

<PageTitle>@L["MultiWeek_Title"] · @L["AppName"]</PageTitle>

<div class="week-bar">
    <button type="button" class="week-bar__button" @onclick="() => ShiftAsync(-7)">‹</button>
    <button type="button" class="week-bar__button" @onclick="GoToTodayAsync">@L["Week_Today"]</button>
    <button type="button" class="week-bar__button" @onclick="() => ShiftAsync(7)">›</button>

    <span class="week-bar__range">@RangeLabel()</span>
    <span class="week-bar__spacer"></span>

    <button type="button" class="week-bar__button @(ShowAllSlots ? "is-on" : null)"
            @onclick="() => ShowAllSlots = !ShowAllSlots">
        @(ShowAllSlots ? L["Slots_Fewer"] : L["Slots_All"])
    </button>

    <label class="week-bar__weeks">
        @L["MultiWeek_Count"]
        <select class="field__input field__input--inline" @onchange="OnWeekCountChanged">
            @foreach (var option in new[] { 2, 4, 6 })
            {
                <option value="@option" selected="@(option == _weeks)">@option</option>
            }
        </select>
    </label>

    <MenuTools Loading="Loading"
               OnRefresh="RefreshAsync"
               CanEdit="CanEdit"
               CanRequest="CanRequest"
               Editing="Editable"
               OnToggleEdit="ToggleEditMode"
               RequestCount="RequestCount"
               PanelOpen="@(Panel == RequestPanelMode.Place)"
               OnRequests="OpenRequests" />
</div>

@if (LoadError is { Length: > 0 })
{
    <div class="issues">@LoadError</div>
}

@if (Conflict)
{
    <div class="issues">@L["Conflict"]</div>
}

<div class="week-bands">
    @foreach (var band in Bands())
    {
        <section class="week-band">
            <div class="menu-grid-scroll">
                <MenuGrid Days="@band"
                          Compact="true"
                          Label="@BandLabel(band)"
                          Slots="@VisibleSlots(band)"
                          Markers="@Markers"
                          Editable="Editable"
                          OnCreate="OnCreate"
                          OnEdit="OnEdit"
                          OnMoveMenu="OnMoveMenu" />
            </div>
        </section>
    }
</div>

<EntryDialog Target="@Editing"
             ReadOnly="@(!Editable)"
             Version="@Range?.Version"
             OnSaved="OnSavedAsync"
             OnCancelled="@(() => Editing = null)" />

<DropChoiceDialog Request="@PendingDrop"
                  OnChosen="OnDropChoiceAsync"
                  OnCancelled="@(() => PendingDrop = null)" />

<MoveToDialog Entry="@Moving"
              OnConfirmed="OnMoveConfirmedAsync"
              OnCancelled="@(() => Moving = null)" />

<RequestPanel Mode="@Panel"
              Requests="@(Range?.Requests ?? [])"
              OnChanged="RefreshAsync"
              OnClosed="@(() => Panel = RequestPanelMode.Closed)" />

@code {
    private DateOnly _start;
    private int _weeks = 4;

    /// <summary>
    /// Visibility is decided per band, not for the whole range: a week with a
    /// snack in it shows the snack row, and the five quiet weeks around it do
    /// not have to carry an empty one for its sake.
    /// </summary>
    private IReadOnlyList<SlotDefinition> VisibleSlots(List<MenuDay> band) =>
        SlotVisibility.Visible(AllSlots, band, ShowAllSlots);

    protected override (DateOnly From, DateOnly To) CurrentSpan() => (_start, _start.AddDays(_weeks * 7 - 1));

    protected override void InitialiseStart() => _start = StartOfWeek(Today);

    /// <summary>Splits the loaded range into one list of days per week.</summary>
    private IEnumerable<List<MenuDay>> Bands()
    {
        var days = Range?.Days ?? [];

        for (var offset = 0; offset + 7 <= days.Count; offset += 7)
        {
            yield return [.. days.Skip(offset).Take(7)];
        }
    }

    private async Task OnWeekCountChanged(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var weeks))
        {
            _weeks = weeks;
            await LoadAsync();
        }
    }

    private async Task ShiftAsync(int days)
    {
        _start = _start.AddDays(days);
        await LoadAsync();
    }

    private async Task GoToTodayAsync()
    {
        _start = StartOfWeek(Today);
        await LoadAsync();
    }

    private string RangeLabel()
    {
        var end = _start.AddDays(_weeks * 7 - 1);
        return $"{_start:d MMM} – {end:d MMM yyyy}";
    }

    private static string BandLabel(List<MenuDay> band) =>
        band.Count == 0 ? string.Empty : $"{band[0].Date:d MMM} – {band[^1].Date:d MMM}";
}
