@page "/menu/multi-week"
@implements IAsyncDisposable
@inject DragController Drag
@inject MenuClient Menu
@inject SystemStatusService Status
@inject IShoppingSchedule Shopping
@inject IStringLocalizer<Strings> L

@*
    Several weeks at once, for moving meals around.

    Reuses MenuGrid one week band at a time rather than rendering one long grid:
    the slot rows have to stay aligned *within* a week, but a band per week keeps
    the day-of-week columns lined up down the page, which is what makes dragging
    "the same dinner, a week later" straightforward.
*@

<PageTitle>@L["MultiWeek_Title"] · @L["AppName"]</PageTitle>

<div class="week-bar">
    <button type="button" class="week-bar__button" @onclick="() => ShiftAsync(-7)">‹</button>
    <button type="button" class="week-bar__button" @onclick="GoToTodayAsync">@L["Week_Today"]</button>
    <button type="button" class="week-bar__button" @onclick="() => ShiftAsync(7)">›</button>

    <span class="week-bar__range">@RangeLabel()</span>
    <span class="week-bar__spacer"></span>

    <label class="week-bar__weeks">
        @L["MultiWeek_Count"]
        <select class="field__input field__input--inline" @onchange="OnWeekCountChanged">
            @foreach (var option in new[] { 2, 4, 6 })
            {
                <option value="@option" selected="@(option == _weeks)">@option</option>
            }
        </select>
    </label>

    @if (_loading)
    {
        <span class="loading">@L["Loading"]</span>
    }
</div>

@if (_conflict)
{
    <div class="issues">@L["Conflict"]</div>
}

<div class="week-bands">
    @foreach (var band in Bands())
    {
        <section class="week-band">
            <h2 class="week-band__label">@BandLabel(band)</h2>

            <div class="menu-grid-scroll">
                <MenuGrid Days="@band"
                          Compact="true"
                          Slots="@_slots"
                          Markers="@_markers"
                          OnCreate="OnCreate"
                          OnEdit="@(e => _editing = e)"
                                      OnMoveMenu="@(e => _moving = e)" />
            </div>
        </section>
    }
</div>

<EntryDialog Target="@_editing"
             Version="@_range?.Version"
             OnSaved="OnSavedAsync"
             OnCancelled="@(() => _editing = null)" />

<DropChoiceDialog Request="@_pendingDrop"
                  OnChosen="OnDropChoiceAsync"
                  OnCancelled="@(() => _pendingDrop = null)" />

<MoveToDialog Entry="@_moving"
              OnConfirmed="OnMoveConfirmedAsync"
              OnCancelled="@(() => _moving = null)" />

@code {
    private MenuRangeResponse? _range;
    private IReadOnlyList<SlotDefinition> _slots = [];
    private List<DayMarker> _markers = [];
    private DateOnly _start;
    private int _weeks = 4;
    private bool _loading = true;
    private bool _conflict;
    private MenuEntryRef? _editing;
    private MenuEntryRef? _moving;
    private DropRequest? _pendingDrop;

    protected override async Task OnInitializedAsync()
    {
        // One drag listener for the page; drops resolve against whatever is
        // currently loaded rather than anything carried through JavaScript.
        Drag.Resolve = ResolveEntry;
        Drag.Dropped += OnDroppedAsync;
        await Drag.AttachAsync();

        var status = await Status.GetAsync();
        _slots = status.Slots;
        _start = StartOfWeek(DateOnly.FromDateTime(DateTime.Now), status.WeekStart);

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _conflict = false;

        _range = await Menu.RangeAsync(_start, _start.AddDays(_weeks * 7 - 1));

        _markers = [];
        if (await Shopping.NextTripAsync() is { } trip)
        {
            _markers.Add(new DayMarker(trip.Order.At, "order", L["Shopping_Order"]));
            _markers.Add(new DayMarker(trip.Delivery.At, "delivery", L["Shopping_Delivery"]));
        }

        _loading = false;
    }

    /// <summary>Splits the loaded range into one list of days per week.</summary>
    private IEnumerable<List<MenuDay>> Bands()
    {
        var days = _range?.Days ?? [];

        for (var offset = 0; offset + 7 <= days.Count; offset += 7)
        {
            yield return [.. days.Skip(offset).Take(7)];
        }
    }

    private async Task OnWeekCountChanged(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var weeks))
        {
            _weeks = weeks;
            await LoadAsync();
        }
    }

    private async Task ShiftAsync(int days)
    {
        _start = _start.AddDays(days);
        await LoadAsync();
    }

    private async Task GoToTodayAsync()
    {
        _start = StartOfWeek(DateOnly.FromDateTime(DateTime.Now), (await Status.GetAsync()).WeekStart);
        await LoadAsync();
    }

    private void OnCreate((DateOnly Date, string Slot) target) =>
        _editing = new MenuEntryRef(target.Date, target.Slot, 0, new MenuEntry { Title = string.Empty });

    private async Task OnDroppedAsync(MenuEntryRef from, DropTarget to, bool copy)
    {
        // A free slot never asks. An occupied one always does.
        if (IsOccupied(to))
        {
            _pendingDrop = new DropRequest(from, to, copy);
            StateHasChanged();
            return;
        }

        await ApplyMoveAsync(from, to, copy, mode: null);
        StateHasChanged();
    }

    /// <summary>Finds the entry a drop refers to in the data now on screen.</summary>
    private MenuEntryRef? ResolveEntry(DateOnly date, string slot, int index)
    {
        var cell = _range?.Days
            .FirstOrDefault(d => d.Date == date)?
            .Cells.FirstOrDefault(c => string.Equals(c.Slot, slot, StringComparison.OrdinalIgnoreCase));

        return cell is not null && index >= 0 && index < cell.Entries.Count
            ? new MenuEntryRef(date, slot, index, cell.Entries[index])
            : null;
    }

    public async ValueTask DisposeAsync()
    {
        Drag.Dropped -= OnDroppedAsync;
        await ValueTask.CompletedTask;
    }

    private async Task OnDropChoiceAsync(DropMode mode)
    {
        if (_pendingDrop is { } pending)
        {
            _pendingDrop = null;
            await ApplyMoveAsync(pending.From, pending.To, pending.Copy, mode);
        }
    }

    private async Task OnMoveConfirmedAsync((DropTarget To, bool Copy) move)
    {
        if (_moving is not { } entry)
        {
            return;
        }

        _moving = null;

        if (IsOccupied(move.To))
        {
            _pendingDrop = new DropRequest(entry, move.To, move.Copy);
            return;
        }

        await ApplyMoveAsync(entry, move.To, move.Copy, mode: null);
    }

    private async Task ApplyMoveAsync(MenuEntryRef from, DropTarget to, bool copy, DropMode? mode)
    {
        var result = await Menu.MoveAsync(from, to, copy, mode, _range?.Version);

        if (result.Conflict)
        {
            _conflict = true;
        }

        await LoadAsync();
    }

    private async Task OnSavedAsync()
    {
        _editing = null;
        await LoadAsync();
    }

    private bool IsOccupied(DropTarget target) =>
        _range?.Days
            .FirstOrDefault(d => d.Date == target.Date)?
            .Cells.FirstOrDefault(c => string.Equals(c.Slot, target.Slot, StringComparison.OrdinalIgnoreCase))
            is { IsEmpty: false };

    private string RangeLabel()
    {
        var end = _start.AddDays(_weeks * 7 - 1);
        return $"{_start:d MMM} – {end:d MMM yyyy}";
    }

    private static string BandLabel(List<MenuDay> band) =>
        band.Count == 0 ? string.Empty : $"{band[0].Date:d MMM} – {band[^1].Date:d MMM}";

    private static DateOnly StartOfWeek(DateOnly date, DayOfWeek weekStart)
    {
        var offset = ((int)date.DayOfWeek - (int)weekStart + 7) % 7;
        return date.AddDays(-offset);
    }
}
