@page "/menu/list"
@inherits MenuViewBase
@inject UiInterop Ui

@*
    Titles only, grouped month then week.

    The counterpart to the grid: there is no layout to preserve, so it can show a
    long span at a glance, which makes it the fastest way to see what has actually
    been planned over a season. Rows are drop targets too, using the same
    DragController and the same collision dialog -- a move made here is the same
    move as a drag in the grid, not a second implementation of it.
*@

<PageTitle>@L["List_Title"] · @L["AppName"]</PageTitle>

<div class="week-bar">
    <button type="button" class="week-bar__button" @onclick="() => ShiftAsync(-1)">‹</button>
    <button type="button" class="week-bar__button" @onclick="GoToTodayAsync">@L["Week_Today"]</button>
    <button type="button" class="week-bar__button" @onclick="() => ShiftAsync(1)">›</button>

    <span class="week-bar__range">@_start.ToString("MMMM yyyy")</span>
    <span class="week-bar__spacer"></span>

    @if (ShowAllSlots || SlotVisibility.HasHidden(AllSlots, Range?.Days ?? [], ShowAllSlots))
    {
        <button type="button" class="week-bar__button @(ShowAllSlots ? "is-on" : null)"
                @onclick="() => ShowAllSlots = !ShowAllSlots">
            @(ShowAllSlots ? L["Slots_Fewer"] : L["Slots_All"])
        </button>
    }

    <MenuTools Loading="Loading"
               OnRefresh="RefreshAsync"
               CanEdit="CanEdit"
               CanRequest="CanRequest"
               Editing="Editable"
               OnToggleEdit="ToggleEditMode"
               RequestCount="RequestCount"
               PanelOpen="@(Panel == RequestPanelMode.Place)"
               OnRequests="OpenRequests" />
</div>

@if (LoadError is { Length: > 0 })
{
    <div class="issues">@LoadError</div>
}

@if (Conflict)
{
    <div class="issues">@L["Conflict"]</div>
}

<div class="panel">
    @if (Range is null)
    {
        <p class="loading">@L["Loading"]</p>
    }
    else if (!Range.Days.Any(d => d.Cells.Any(c => !c.IsEmpty)))
    {
        <p class="muted">@L["List_Empty"]</p>
    }
    else
    {
        @foreach (var week in Weeks())
        {
            <section class="list-week @(IsThisWeek(week.Key) ? "is-current" : null)">
                <button type="button" class="list-week__head" @onclick="() => Toggle(week.Key)">
                    <span class="list-week__chevron @(IsOpen(week.Key) ? "is-open" : null)" aria-hidden="true">›</span>
                    <span>@WeekLabel(week)</span>
                    <span class="list-week__count">@week.Sum(d => d.Cells.Sum(c => c.Entries.Count))</span>
                </button>

                @if (IsOpen(week.Key))
                {
                    @* A row per day and a column per slot. Every day is present,
                       including empty ones -- a day you cannot see is a day you
                       cannot drop onto, which would make this view read-only.
                       Laid out as a table rather than stacked lines, or a month
                       of mostly-empty days becomes a page of dashes. *@
                    <div class="list-grid" style="--slot-count:@VisibleSlots.Count">
                        <span class="list-grid__corner"></span>

                        @foreach (var slot in VisibleSlots)
                        {
                            <span class="list-grid__slot @SlotTone.CssClass(slot.Key)">@slot.Label(Culture)</span>
                        }

                        @foreach (var day in week)
                        {
                            <span class="list-grid__date @(IsToday(day.Date) ? "is-today" : null)"
                                  id="@(IsToday(day.Date) ? "today" : null)">
                                @day.Date.ToString("ddd d")

                                @foreach (var marker in MarkersOn(day.Date))
                                {
                                    <span class="list-day__marker list-day__marker--@marker.Kind"
                                          title="@marker.Label">
                                        @marker.At.ToString("HH:mm")
                                    </span>
                                }
                            </span>

                            @foreach (var slot in VisibleSlots)
                            {
                                var cell = day.Cells.FirstOrDefault(c =>
                                    string.Equals(c.Slot, slot.Key, StringComparison.OrdinalIgnoreCase));

                                <div class="list-grid__cell @SlotTone.CssClass(slot.Key)"
                                     data-drop-date="@day.Date.ToString("yyyy-MM-dd")"
                                     data-drop-slot="@slot.Key">

                                    @if (cell is null || cell.IsEmpty)
                                    {
                                        @if (Editable)
                                        {
                                            <button type="button" class="list-grid__add"
                                                    title="@L["Grid_Add"]"
                                                    @onclick="() => OnCreate(day.Date, slot.Key)">
                                                <span aria-hidden="true">+</span>
                                            </button>
                                        }
                                    }
                                    else
                                    {
                                        @for (var i = 0; i < cell.Entries.Count; i++)
                                        {
                                            var index = i;
                                            var entry = cell.Entries[index];

                                            <button type="button" class="list-grid__entry"
                                                    title="@entry.Title"
                                                    data-drag-date="@(Editable ? day.Date.ToString("yyyy-MM-dd") : null)"
                                                    data-drag-slot="@(Editable ? slot.Key : null)"
                                                    data-drag-index="@(Editable ? index : null)"
                                                    data-drag-title="@(Editable ? entry.Title : null)"
                                                    @onclick="() => OnEdit(new MenuEntryRef(day.Date, slot.Key, index, entry))">
                                                @entry.Title
                                            </button>
                                        }

                                        @if (cell.IsDuplicated)
                                        {
                                            <span class="menu-cell__flag">@L["Duplicate_Short"]</span>
                                        }
                                    }
                                </div>
                            }
                        }
                    </div>
                }
            </section>
        }
    }
</div>

<EntryDialog Target="@Editing"
             ReadOnly="@(!Editable)"
             Version="@Range?.Version"
             OnSaved="OnSavedAsync"
             OnCancelled="@(() => Editing = null)" />

<DropChoiceDialog Request="@PendingDrop"
                  OnChosen="OnDropChoiceAsync"
                  OnCancelled="@(() => PendingDrop = null)" />

<RequestPanel Mode="@Panel"
              Requests="@(Range?.Requests ?? [])"
              OnChanged="RefreshAsync"
              OnClosed="@(() => Panel = RequestPanelMode.Closed)" />

@code {
    private DateOnly _start;
    private bool _scrollPending;
    private readonly HashSet<DateOnly> _collapsed = [];

    /// <summary>
    /// One column set for every week on screen, computed across the whole month.
    ///
    /// The grid views decide this per week, which keeps a quiet week from
    /// carrying an empty row for a busy one. That trade is wrong here: the weeks
    /// are stacked one above another, so a week with an extra column makes every
    /// column below it step sideways. Aligned columns are worth more than the
    /// occasional empty one.
    /// </summary>
    private IReadOnlyList<SlotDefinition> VisibleSlots =>
        SlotVisibility.Visible(AllSlots, Range?.Days ?? [], ShowAllSlots);

    private IEnumerable<DayMarker> MarkersOn(DateOnly date) =>
        Markers.Where(m => DateOnly.FromDateTime(m.At) == date);

    private static string Culture =>
        System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;

    private static bool IsToday(DateOnly date) => date == Today;

    private bool IsThisWeek(DateOnly weekStart) => weekStart == StartOfWeek(Today);

    /// <summary>Whole weeks around the month, so a week straddling the boundary is not shown cut in half.</summary>
    protected override (DateOnly From, DateOnly To) CurrentSpan() =>
        (StartOfWeek(_start), StartOfWeek(_start.AddMonths(1).AddDays(-1)).AddDays(6));

    protected override void InitialiseStart() => _start = new DateOnly(Today.Year, Today.Month, 1);

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        ScrollToTodayIfShown();
    }

    /// <summary>
    /// Brings today into view once the month has rendered. A month opens at the
    /// 1st, which is rarely where anyone wants to start reading. Not on a
    /// background refresh, which must leave the scroll position alone.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_scrollPending)
        {
            _scrollPending = false;
            await Ui.ScrollIntoViewAsync("today");
        }
    }

    private void ScrollToTodayIfShown() =>
        _scrollPending = Range?.Days.Any(d => IsToday(d.Date)) == true;

    private void OnCreate(DateOnly date, string slot) => OnCreate((date, slot));

    private IEnumerable<IGrouping<DateOnly, MenuDay>> Weeks() =>
        (Range?.Days ?? []).GroupBy(d => StartOfWeek(d.Date));

    private bool IsOpen(DateOnly week) => !_collapsed.Contains(week);

    private void Toggle(DateOnly week)
    {
        if (!_collapsed.Add(week))
        {
            _collapsed.Remove(week);
        }
    }

    private async Task ShiftAsync(int months)
    {
        _start = _start.AddMonths(months);
        await LoadAsync();
        ScrollToTodayIfShown();
    }

    private async Task GoToTodayAsync()
    {
        InitialiseStart();
        await LoadAsync();
        ScrollToTodayIfShown();
    }

    private static string WeekLabel(IGrouping<DateOnly, MenuDay> week) =>
        $"{week.Key:d MMM} – {week.Key.AddDays(6):d MMM}";
}
