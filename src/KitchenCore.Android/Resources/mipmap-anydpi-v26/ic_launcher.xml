<?xml version="1.0" encoding="utf-8"?>
<!-- Android 8+: the launcher cuts its own shape from these two layers. The
     monochrome layer is what Android 13+ tints for themed icons. Older versions
     use the PNGs in mipmap-*dpi, rendered by scripts/render-icons.ps1. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
  <background android:drawable="@color/ic_launcher_background" />
  <foreground android:drawable="@drawable/ic_launcher_foreground" />
  <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
